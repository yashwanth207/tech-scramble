# ==========================================
# TECH SCRAMBLE ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Admin Authorization Key
# Used by Admin Dashboard (/admin) and Host Screen (/host)
ADMIN_UPLOAD_KEY=Bommali

# 2. Firebase Configuration (Optional)
# If using Firebase Firestore & Storage:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# 3. Supabase Configuration (Optional)
# If using Supabase PostgreSQL & Storage:
# NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
